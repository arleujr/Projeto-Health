Set-Content -Path package.json -Value @'
{
  "name": "core-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Core backend do Projeto Health",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^2.12.0",
    "express": "^4.18.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "zod": "^4.24.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.1"
  }
}
'@
